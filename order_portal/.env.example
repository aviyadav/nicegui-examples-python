# Database (PostgreSQL)
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=orders
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy async URL (built from POSTGRES_* if DATABASE_URL is empty)
DATABASE_URL=

# Redis
REDIS_URL=redis://redis:6379/0

# Celery (uses REDIS_URL as broker + result backend)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Application
APP_HOST=0.0.0.0
APP_PORT=8080
# Secret used to sign the session cookie. Change in production.
SESSION_SECRET=change-me-in-production-please
# Set to 1 to disable auth gating (debugging only).
AUTH_DISABLED=0
